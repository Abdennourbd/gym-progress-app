# The secret the session cookie is signed with.
#
# Required in production, at least 32 characters. Make one with:
#
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
#
# In development the app makes a temporary one instead, so a fresh clone runs
# without any setup. The temporary one lasts as long as the process, so
# everybody is signed out when the server restarts.
AUTH_SECRET=

# The cloud store.
#
# The Vercel marketplace integration fills these in. A self hosted Upstash
# database uses UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN instead.
# Without either pair the app keeps everything in .data/ on the server, which
# is only useful in development.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional. When it is set, an account needs this code before it can be made.
# Leave it empty and anybody with the link can sign up.
GYM_INVITE_CODE=
